{
  "expo": {
    "name": "offix",
    "slug": "offix",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.offix.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ru.offix.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-asset",
      "expo-video",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "offix прикрепляет фото и видео к сообщениям, задачам и комментариям, а также ставит фото профиля.",
          "cameraPermission": "offix снимает фото и видео, чтобы отправить их коллегам.",
          "microphonePermission": "offix записывает звук для видео, которое вы снимаете."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "offix снимает видеосообщения-кружочки и сканирует QR-коды: вход на сайте и профили коллег.",
          "microphonePermission": "offix записывает звук в видеосообщениях.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "offix записывает голосовые сообщения."
        }
      ]
    ],
    "scheme": "offix",
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1"
    }
  }
}
