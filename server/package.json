{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "offix API: Express 5 + PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memory": "tsx src/dev-memory.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@offix/core": "*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
