# Настройки сервера offix. Скопируйте в server/.env и заполните.
# Сервер читает этот файл сам при запуске (переменные окружения службы важнее файла).

# production — отдавать собранный сайт (web/dist), строгая проверка JWT_SECRET
NODE_ENV=development
# Адрес PostgreSQL
DATABASE_URL=postgres://offix:offix@localhost:5432/offix
# Секрет для подписи токенов — длинная случайная строка из букв и цифр (не меньше 32 символов, без #)
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# На каком адресе слушать: за прокси или туннелем — 127.0.0.1 (снаружи порт не виден); пусто — все адреса
HOST=
# Где собранный сайт: пусто — web/dist (при NODE_ENV=production), off — только API
WEB_DIST_DIR=
# Откуда разрешены запросы сайта, если он открыт с другого адреса (через запятую).
# Когда сайт отдаёт сам сервер (один адрес), этот список не нужен.
CORS_ORIGINS=http://localhost:5173
# Файлы: папка (по умолчанию server/data/uploads) и предел одного файла в МБ
UPLOADS_DIR=
UPLOAD_MAX_MB=200
# Папка с ffmpeg и ffprobe (обложки видео, голосовые с сайта); off — не искать
FFMPEG_DIR=
# Push-уведомления на телефоны через Expo: 1 — включить
PUSH_ENABLED=0
# Токен доступа Expo, если в проекте включена защита push (необязательно)
EXPO_ACCESS_TOKEN=
# Отчёт руководству на почту по расписанию: 1 — включить (нужны SMTP_URL и MAIL_FROM)
REPORT_MAIL_ENABLED=0
# Почтовый сервер, например smtps://user:password@smtp.yandex.ru:465
SMTP_URL=
# Отправитель писем, например offix <reports@example.ru>
MAIL_FROM=
# Адрес сайта для ссылок в письме (необязательно), например https://offix.example.ru
APP_URL=
# Синхронизация с 1С и Moodle по расписанию: 1 — включить
INTEGRATIONS_ENABLED=0
# Ключ шифрования паролей интеграций (32 байта в base64); пусто — выводится из JWT_SECRET
INTEGRATIONS_SECRET_KEY=
# Помощник базы знаний: ollama — ответы пишет нейросеть Ollama на вашем сервере; пусто — встроенный поиск и ответ цитатами
KNOWLEDGE_AI=
# Адрес Ollama и модели (необязательно)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b
