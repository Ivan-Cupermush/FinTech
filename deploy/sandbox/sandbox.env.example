# /opt/offix/server/.env — настройки песочницы. Права: chmod 600, владелец offix.
# Встроенная база PGlite в папке: PostgreSQL ставить не нужно. Свой PostgreSQL — postgres://…
DATABASE_URL=pglite:/var/lib/offix/pgdata
UPLOADS_DIR=/var/lib/offix/uploads
# Оригиналы файлов: kusok (дедупликация, нужен npm run kusok:build), fs — папка, auto — kusok, если собран.
UPLOADS_STORE=auto
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=
PORT=4000
# Только для nginx на этой же машине — снаружи порт 4000 не виден.
HOST=127.0.0.1
CORS_ORIGINS=http://offix.147-45-43-34.sslip.io
APP_URL=http://offix.147-45-43-34.sslip.io
